{
  "args": {
    "data_root": "data/molnet",
    "out_dir": "results/molnet_perset",
    "device": "auto",
    "datasets": [
      "esol"
    ],
    "K_sweep": [
      5,
      10
    ],
    "models": [
      "gcn-ds",
      "gcn-st",
      "gsc-bc",
      "gsc-ca"
    ],
    "split_kind": "scaffold",
    "split_seed": 0,
    "train_ratio": 0.8,
    "val_ratio": 0.1,
    "feature_mode": "rich",
    "hidden": 128,
    "layers": 3,
    "num_heads": 4,
    "dropout": 0.1,
    "equalize_params": "none",
    "epochs": 40,
    "patience": 10,
    "batch_size": 16,
    "lr": 0.0001,
    "weight_decay": 1e-05,
    "seeds": 1,
    "seed_offset": 0,
    "quick": true
  },
  "models": {
    "gcn-ds": "GCN+DeepSets",
    "gcn-st": "GCN+SetTransformer",
    "gsc-bc": "GraphSetConv-Broadcast",
    "gsc-ca": "GraphSetConv-CrossAttn"
  },
  "env": {
    "python": "3.14.4",
    "torch": "2.10.0+cu128",
    "platform": "Linux-7.0.3-1-cachyos-x86_64-with-glibc2.43",
    "cuda": false
  }
}